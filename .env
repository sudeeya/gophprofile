SERVER_PORT=8080
SERVER_SHUTDOWN_TIMEOUT=5s

WORKER_SHUTDOWN_TIMEOUT=5s

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=db

GOOSE_DRIVER=postgres
GOOSE_DBSTRING="host=postgres port=5432 user=user password=password dbname=db"
GOOSE_MIGRATION_DIR=./migrations

MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=user
MINIO_ROOT_PASSWORD=password

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=user
RABBITMQ_DEFAULT_PASS=password
RABBITMQ_PUBLISHER_CONFIRMS_RETRY_ATTEMPTS=5
RABBITMQ_PUBLISHER_CONFIRMS_RETRY_DELAY=100ms
RABBITMQ_SERVER_ADDITIONAL_ERL_ARGS="+sbwt none +sbwtdcpu none +sbwtdio none"
